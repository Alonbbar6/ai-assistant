# Copy this to .env and fill in your values

# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth (for Calendar + Gmail)
# Download from https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_SECRETS_FILE=credentials/google_credentials.json

# Email settings
EMAIL_FROM=your.email@gmail.com

# Voice settings (optional, defaults work on most systems)
VOICE_LANGUAGE=en-US
VOICE_RATE=175        # TTS words per minute
WHISPER_MODEL=base    # tiny | base | small | medium | large
